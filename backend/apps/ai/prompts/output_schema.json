{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["summary", "issues"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "总体审查评估"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_path", "start_line", "end_line", "severity", "dimension", "title", "description", "suggestion", "confidence"],
        "properties": {
          "file_path": {
            "type": "string",
            "description": "文件路径"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "dimension": {
            "type": "string",
            "enum": ["security", "correctness", "performance", "maintainability", "type_safety", "completeness", "best_practices"]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          },
          "code_snippet": {
            "type": "string"
          },
          "fix_snippet": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    }
  }
}
