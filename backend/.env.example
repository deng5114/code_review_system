# CodeReview Pro 环境变量配置
# 开发模式默认启用，无需配置 Redis，只需在设置页面配置 AI 模型即可使用

# Django（开发模式默认启用）
DJANGO_DEVELOPMENT=True
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Celery（开发模式默认用内存，不需要 Redis）
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# ============================================================
# 生产环境配置（取消注释并填写）
# ============================================================
# DJANGO_DEVELOPMENT=False
# DJANGO_SECRET_KEY=使用 python -c "import secrets; print(secrets.token_hex(50))" 生成
# CELERY_TASK_ALWAYS_EAGER=False
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CHANNEL_REDIS_URL=redis://localhost:6379/1

# AES-256-GCM encryption key for API keys (64-char hex string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production; dev mode falls back to Django signing
AES_ENCRYPTION_KEY=
